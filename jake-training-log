      <input class="rpe-input" type="number" placeholder="—" id="${ex.id}-rpe-${s}" min="1" max="10">
    </div>`;
  }

  return `<div class="exercise-block ${typeClass}">
    <div class="exercise-header">
      <div>
        <div class="exercise-name">${ex.name} <span class="badge badge-target">${currentLabel || (ex.sets+'×'+ex.reps)}</span></div>
        <div class="exercise-note-text">${ex.note}</div>
      </div>
    </div>
    ${setsHTML}
    <div class="weight-row">
      <label>Weight</label>
      <input class="weight-input" type="text" placeholder="${ex.weight || 'bodyweight'}" id="${ex.id}-weight">
    </div>
    <textarea class="ex-notes" id="${ex.id}-notes" placeholder="Notes..." rows="1"></textarea>
  </div>`;
}

