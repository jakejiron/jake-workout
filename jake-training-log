<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jake's Training Log</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F2F4F8;
    --surface: #FFFFFF;
    --surface2: #EEF1F6;
    --surface3: #E4E8F0;
    --border: #D8DDE8;
    --border2: #BCC4D4;
    --text: #0A1228;
    --text2: #3D4A60;
    --text3: #7A8499;
    --azul: #0A2B6E;
    --azul-mid: #1A3F8F;
    --azul-light: #EDF1FB;
    --azul-border: #B0C0E0;
    --chrome: #7A8EAA;
    --chrome-light: #F0F3F8;
    --chrome-border: #C0CAD8;
    --orange: #D94E08;
    --orange-light: #FEF0E8;
    --orange-border: #F0A880;
    --gold: #B87D00;
    --gold-light: #FEF7E0;
    --gold-border: #E8CC70;
    --red: #B81C1C;
    --red-light: #FEF0F0;
    --teal: #0A7A60;
    --teal-light: #E8F7F3;
    --teal-border: #70C8B0;
    --radius: 12px;
    --radius-sm: 8px;
    font-family: 'Barlow', sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); min-height: 100vh; font-size: 15px; line-height: 1.6; }

  /* NAV */
  .nav { background: var(--azul); padding: 0 20px; display: flex; align-items: center; justify-content: space-between; height: 56px; position: sticky; top: 0; z-index: 100; }
  .nav-logo { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 20px; letter-spacing: 2px; text-transform: uppercase; color: #fff; }
  .nav-logo span { color: var(--orange); margin-left: 3px; }
  .nav-tabs { display: flex; gap: 4px; }
  .nav-tab { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); padding: 7px 16px; font-size: 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.65); cursor: pointer; border-radius: var(--radius-sm); transition: all 0.15s; }
  .nav-tab:hover { background: rgba(255,255,255,0.18); color: #fff; }
  .nav-tab.active { background: var(--orange); border-color: var(--orange); color: #fff; }

  /* PANELS */
  .panel { display: none; padding: 20px; max-width: 720px; margin: 0 auto; }
  .panel.active { display: block; }

  /* CARDS */
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin-bottom: 14px; }
  .card-title { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--text3); margin-bottom: 14px; }

  /* DAY SELECTOR */
  .day-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; margin-bottom: 18px; }
  .day-btn { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 4px; text-align: center; cursor: pointer; transition: all 0.15s; }
  .day-btn:hover { border-color: var(--azul-border); background: var(--azul-light); }
  .day-btn.active-strength { background: var(--azul); border-color: var(--azul); }
  .day-btn.active-strength .day-name { color: #fff; }
  .day-btn.active-strength .day-type { color: rgba(255,255,255,0.55); }
  .day-btn.active-hypertrophy { background: var(--orange-light); border-color: var(--orange-border); }
  .day-btn.active-hypertrophy .day-name { color: var(--orange); }
  .day-btn.active-hypertrophy .day-type { color: var(--orange); }
  .day-btn.active-recovery { background: var(--teal-light); border-color: var(--teal-border); }
  .day-btn.active-recovery .day-name { color: var(--teal); }
  .day-btn.active-recovery .day-type { color: var(--teal); }
  .day-btn.active-rest { background: var(--surface2); border-color: var(--border2); }
  .day-btn .day-name { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--text2); }
  .day-btn .day-type { font-size: 9px; color: var(--text3); margin-top: 3px; font-family: 'Barlow Condensed', sans-serif; letter-spacing: 0.5px; text-transform: uppercase; }

  /* SESSION HEADER BANNER */
  .session-banner { border-radius: var(--radius); padding: 18px 20px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; }
  .session-banner.strength { background: var(--azul); border: 1px solid var(--azul); }
  .session-banner.strength .banner-day { color: #fff; }
  .session-banner.strength .banner-theme { color: rgba(255,255,255,0.5); }
  .session-banner.strength .banner-bg { color: rgba(255,255,255,0.05); }
  .session-banner.hypertrophy { background: var(--orange-light); border: 1px solid var(--orange-border); }
  .session-banner.hypertrophy .banner-day { color: var(--orange); }
  .session-banner.hypertrophy .banner-theme { color: var(--text3); }
  .session-banner.hypertrophy .banner-bg { color: rgba(217,78,8,0.07); }
  .session-banner.recovery { background: var(--teal-light); border: 1px solid var(--teal-border); }
  .session-banner.recovery .banner-day { color: var(--teal); }
  .session-banner.recovery .banner-theme { color: var(--text3); }
  .session-banner.recovery .banner-bg { color: rgba(10,122,96,0.07); }
  .session-banner .banner-day { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 28px; letter-spacing: 1px; text-transform: uppercase; }
  .session-banner .banner-theme { font-size: 12px; font-family: 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; margin-top: 2px; }
  .banner-bg { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 44px; letter-spacing: 2px; line-height: 1; user-select: none; }

  /* SECTION LABELS */
  .section-label { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin: 20px 0 10px; padding: 8px 12px; border-radius: var(--radius-sm); display: flex; align-items: center; gap: 8px; }
  .section-label.core { background: var(--gold-light); color: var(--gold); border: 1px solid var(--gold-border); }
  .section-label.main { background: var(--azul-light); color: var(--azul-mid); border: 1px solid var(--azul-border); }

  /* EXERCISE BLOCKS */
  .exercise-block { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; margin-bottom: 10px; border-left: 4px solid var(--border); }
  .exercise-block.compound { border-left-color: var(--azul); }
  .exercise-block.isolation { border-left-color: var(--orange); }
  .exercise-block.core-ex { border-left-color: var(--gold); }
  .exercise-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; }
  .exercise-name { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 18px; letter-spacing: 0.5px; color: var(--text); }
  .exercise-note-text { font-size: 12px; color: var(--text3); margin-top: 2px; }

  .set-header { display: grid; grid-template-columns: 40px 1fr 1fr 1fr; gap: 8px; margin-bottom: 6px; }
  .set-header span { font-size: 10px; color: var(--text3); font-family: 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .set-row { display: grid; grid-template-columns: 40px 1fr 1fr 1fr; gap: 8px; align-items: center; margin-bottom: 6px; }
  .set-label { font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 13px; color: var(--text3); letter-spacing: 1px; }
  .set-input, .rpe-input { background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; font-size: 15px; width: 100%; font-family: 'Barlow', sans-serif; font-weight: 600; color: var(--text); transition: border-color 0.15s; }
  .set-input:focus { outline: none; border-color: var(--azul); background: #fff; }
  .rpe-input:focus { outline: none; border-color: var(--orange); background: #fff; }
  .set-input::placeholder, .rpe-input::placeholder { color: var(--text3); font-weight: 400; }

  .weight-row { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
  .weight-row label { font-size: 11px; font-family: 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--text3); }
  .weight-input { background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; padding: 6px 10px; font-size: 13px; width: 130px; font-family: 'Barlow', sans-serif; color: var(--text); }
  .weight-input:focus { outline: none; border-color: var(--chrome); }
  .ex-notes { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; padding: 7px 10px; font-size: 13px; font-family: 'Barlow', sans-serif; color: var(--text2); margin-top: 8px; resize: none; min-height: 34px; }
  .ex-notes:focus { outline: none; border-color: var(--border2); }
  .ex-notes::placeholder { color: var(--text3); }

  /* BADGES */
  .badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: 0.5px; }
  .badge-target { background: var(--chrome-light); color: var(--chrome); border: 1px solid var(--chrome-border); }
  .badge-green { background: var(--teal-light); color: var(--teal); border: 1px solid var(--teal-border); }
  .badge-amber { background: var(--gold-light); color: var(--gold); border: 1px solid var(--gold-border); }
  .badge-gray { background: var(--surface2); color: var(--text3); border: 1px solid var(--border); }
  .pr-tag { font-size: 10px; background: var(--teal-light); color: var(--teal); padding: 2px 7px; border-radius: 20px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; border: 1px solid var(--teal-border); }
  .overload-flag { font-size: 11px; background: var(--gold-light); color: var(--gold); padding: 3px 8px; border-radius: 20px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; cursor: pointer; border: 1px solid var(--gold-border); }

  /* CHECKLIST */
  .checklist-item { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--border); cursor: pointer; }
  .checklist-item:last-child { border-bottom: none; }
  .checklist-item input[type=checkbox] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--azul); }
  .checklist-item label { font-size: 14px; cursor: pointer; flex: 1; color: var(--text2); }
  .checklist-item:hover label { color: var(--text); }
  .checklist-item.done label { text-decoration: line-through; color: var(--text3); }

  /* BUTTONS */
  .btn { padding: 10px 20px; border-radius: var(--radius-sm); font-size: 13px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; border: 1px solid var(--border2); background: var(--surface); color: var(--text2); transition: all 0.15s; }
  .btn:hover { background: var(--surface2); color: var(--text); }
  .btn-primary { background: var(--azul); color: #fff; border-color: var(--azul); }
  .btn-primary:hover { background: var(--azul-mid); }
  .btn-sm { padding: 6px 14px; font-size: 12px; }
  .btn-row { display: flex; gap: 10px; margin-top: 18px; }

  /* SESSION NOTES */
  .session-notes { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 12px; font-size: 14px; font-family: 'Barlow', sans-serif; color: var(--text); min-height: 70px; resize: vertical; }
  .session-notes:focus { outline: none; border-color: var(--border2); }
  .session-notes::placeholder { color: var(--text3); }

  /* MODAL */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(10,18,40,0.5); z-index: 200; align-items: center; justify-content: center; padding: 20px; }
  .modal-overlay.open { display: flex; }
  .modal { background: var(--surface); border-radius: var(--radius); padding: 28px; max-width: 420px; width: 100%; border: 1px solid var(--gold-border); border-top: 4px solid var(--gold); }
  .modal h3 { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 22px; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 8px; color: var(--text); }
  .modal p { font-size: 14px; color: var(--text2); line-height: 1.6; margin-bottom: 14px; }
  .modal-badge { display: inline-block; background: var(--gold-light); color: var(--gold); padding: 4px 12px; border-radius: 20px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 14px; border: 1px solid var(--gold-border); }

  /* HISTORY */
  .history-item { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--border); border-radius: var(--radius); padding: 16px; margin-bottom: 10px; cursor: pointer; transition: all 0.15s; }
  .history-item:hover { border-color: var(--azul-border); border-left-color: var(--azul); }
  .history-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
  .history-date { font-size: 12px; font-family: 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--text3); }
  .history-day { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 18px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--text); }
  .history-notes { font-size: 13px; color: var(--text2); margin-top: 8px; border-top: 1px solid var(--border); padding-top: 8px; }
  .history-detail { display: none; margin-top: 12px; }
  .history-item.expanded .history-detail { display: block; }

  /* CHARTS */
  .chart-controls { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; align-items: center; }
  .chart-controls select { background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 7px 10px; font-size: 13px; font-family: 'Barlow', sans-serif; color: var(--text); }
  .chart-wrap { position: relative; height: 220px; margin-bottom: 24px; }

  /* TOAST */
  .toast { position: fixed; bottom: 24px; right: 20px; background: var(--azul); color: #fff; padding: 10px 18px; border-radius: var(--radius-sm); font-size: 13px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; z-index: 300; opacity: 0; transition: opacity 0.2s; pointer-events: none; }
  .toast.show { opacity: 1; }

  .note-box { background: var(--red-light); border: 1px solid #F0B0B0; border-radius: var(--radius-sm); padding: 10px 14px; font-size: 13px; color: var(--red); margin-bottom: 16px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; }

  .empty-state { text-align: center; padding: 48px 20px; color: var(--text3); font-size: 14px; }
  .empty-state .big { font-size: 32px; margin-bottom: 8px; }

  @media (max-width: 500px) {
    .nav-tabs { gap: 2px; }
    .nav-tab { padding: 6px 10px; font-size: 11px; }
    .set-row, .set-header { grid-template-columns: 32px 1fr 1fr 50px; }
    .day-btn .day-name { font-size: 11px; }
  }
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-logo">JAKE<span>///</span>LOG</div>
  <div class="nav-tabs">
    <button class="nav-tab active" onclick="switchPanel('log')">Log</button>
    <button class="nav-tab" onclick="switchPanel('history')">History</button>
    <button class="nav-tab" onclick="switchPanel('charts')">Charts</button>
  </div>
</nav>

<!-- LOG PANEL -->
<div class="panel active" id="panel-log">
  <div class="day-grid" id="dayGrid"></div>
  <div id="programContent"></div>
</div>

<!-- HISTORY PANEL -->
<div class="panel" id="panel-history">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <div style="font-size:18px;font-weight:700;">Session History</div>
    <button class="btn btn-sm" onclick="exportData()">Export JSON</button>
  </div>
  <div id="historyList"></div>
</div>

<!-- CHARTS PANEL -->
<div class="panel" id="panel-charts">
  <div class="card">
    <div class="card-title">Volume Over Time</div>
    <div class="chart-controls">
      <select id="chartExercise" onchange="renderCharts()"></select>
    </div>
    <div class="chart-wrap"><canvas id="volumeChart"></canvas></div>
  </div>
  <div class="card">
    <div class="card-title">RPE Trend</div>
    <div class="chart-wrap"><canvas id="rpeChart"></canvas></div>
  </div>
  <div class="card" id="prCard">
    <div class="card-title">Personal Records</div>
    <div id="prList"></div>
  </div>
</div>

<!-- OVERLOAD MODAL -->
<div class="modal-overlay" id="overloadModal">
  <div class="modal">
    <div class="modal-badge" id="modalBadge">↑ OVERLOAD READY</div>
    <h3 id="modalTitle">Progress Ring Dips?</h3>
    <p id="modalBody">You've completed 3 consecutive sessions hitting all target reps at RPE ≤7. Ready to progress.</p>
    <p style="font-size:13px;font-family:'Courier New',monospace;color:var(--text3);margin-bottom:16px;" id="modalProgress"></p>
    <div class="btn-row">
      <button class="btn btn-primary" id="modalConfirm">Yes, update target</button>
      <button class="btn" onclick="closeModal()">Not yet</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ─── PROGRAM DATA ──────────────────────────────────────────────────────────────

const DAYS = [
  { name: 'Mon', label: 'Strength', type: 'main', theme: 'Horizontal Push + Vertical Pull' },
  { name: 'Tue', label: 'Strength', type: 'main', theme: 'Vertical Push + Horizontal Pull' },
  { name: 'Wed', label: 'Recovery', type: 'recovery' },
  { name: 'Thu', label: 'Hypertrophy', type: 'main', theme: 'Horizontal Push + Vertical Pull' },
  { name: 'Fri', label: 'Hypertrophy', type: 'main', theme: 'Vertical Push + Horizontal Pull' },
  { name: 'Sat', label: 'Recovery', type: 'recovery' },
  { name: 'Sun', label: 'Rest', type: 'rest' }
];

const WARMUP_MON_TUE_THU = [
  'Arm circles — 10 forward, 10 backward',
  'Shoulder CARs — 5 each side',
  'Scapular wall slides — 10 reps',
  'Prone Y-T-W — 5 reps each position'
];
const WARMUP_FRI = [
  'Arm circles — 10 forward, 10 backward',
  'Band pull-aparts — 15 reps',
  'Scap shrugs on rings — 10 reps',
  'Dead hangs — 2×20sec'
];

const PROGRAM = {
  0: { // MON
    warmup: WARMUP_MON_TUE_THU,
    core: [
      { id: 'c0-dead-bug', name: 'Dead Bug', sets: 3, reps: 8, note: '8/side, 3sec hold, slow return, 30sec rest' },
      { id: 'c0-bird-dog', name: 'Bird Dog', sets: 3, reps: 8, note: '8/side, 3sec hold at extension, 30sec rest' },
      { id: 'c0-hollow-body', name: 'Hollow Body Hold', sets: 3, reps: 30, unit: 'sec', note: '30sec rest' }
    ],
    exercises: [
      { id: 'ring-dips-s', name: 'Ring Dips', sets: 4, reps: 7, note: '3sec deficit, 1sec pause, turn out at top, 2min rest', type: 'compound' },
      { id: 'ring-pullups-s', name: 'Ring Pull-Ups', sets: 4, reps: 7, note: '4sec eccentric, 2min rest', type: 'compound' },
      { id: 'deficit-pushups', name: 'Deficit Push-Ups', sets: 4, reps: 8, note: '6sec down, 3sec pause, fast up, 45°, 90sec rest', type: 'compound' },
      { id: 'gorilla-rows-s', name: 'Gorilla Rows', sets: 4, reps: 18, note: '9/side @ 16kg, 5sec eccentric, 2sec hold, 2min rest', type: 'compound', weight: '16kg' }
    ]
  },
  1: { // TUE
    warmup: WARMUP_MON_TUE_THU,
    core: [
      { id: 'c1-dead-bug', name: 'Dead Bug', sets: 3, reps: 8, note: '8/side, 3sec hold, 30sec rest' },
      { id: 'c1-side-plank', name: 'Side Plank', sets: 3, reps: 40, unit: 'sec', note: 'Each side back-to-back = 1 set, 30sec rest' }
    ],
    exercises: [
      { id: 'handstand', name: 'Wall Handstand Hold', sets: 4, reps: 45, unit: 'sec', note: '20-30sec lift-off, finish on wall, 60sec rest', type: 'compound' },
      { id: 'kb-press', name: 'KB Strict Press', sets: 4, reps: 8, note: '@ 16kg strict, no leg drive, 2min rest', type: 'compound', weight: '16kg' },
      { id: 'ring-rows-s', name: 'Horizontal Ring Rows', sets: 4, reps: 9, note: 'Feet elevated, 2sec hold at top, 2min rest', type: 'compound' },
      { id: 'rear-delt', name: 'Rear Delt Raises', sets: 3, reps: 12, note: '@ 10lb, controlled, deliberate, 60sec rest', type: 'isolation', weight: '10lb' }
    ]
  },
  2: { // WED
    recovery: [
      'Cat/cow — 10 slow reps',
      'Thoracic rotation — 10 each side (quadruped)',
      'Thread the needle — 8 each side, 2sec hold',
      'Shoulder CARs — 5 each side',
      'Doorway chest stretch — 2×30sec each position',
      'Lat stretch on rings — 30sec each side',
      'Wrist circles + extensions — 2 min',
      'Dead Bug — 2×8/side (slow, quality)',
      'Bird Dog — 2×8/side (slow, controlled)',
      'Hollow Body Hold — 2×20sec',
      'Box breathing — 5 min lying down'
    ]
  },
  3: { // THU
    warmup: WARMUP_MON_TUE_THU,
    core: [
      { id: 'c3-bird-dog', name: 'Bird Dog', sets: 3, reps: 12, note: '12/side, 1sec hold, 30sec rest' },
      { id: 'c3-hollow-rocks', name: 'Hollow Body Rocks', sets: 3, reps: 15, note: '30sec rest' },
      { id: 'c3-side-plank', name: 'Side Plank', sets: 3, reps: 40, unit: 'sec', note: 'Each side back-to-back = 1 set, 30sec rest' }
    ],
    exercises: [
      { id: 'ring-dips-h', name: 'Ring Dips', sets: 3, reps: 12, note: 'Controlled descent, no deficit, turn out at top, 90sec rest', type: 'compound' },
