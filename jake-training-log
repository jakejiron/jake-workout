      html += buildExerciseBlock(ex, currentLabel, prog);
    });
  }

  html += `<div class="card"><div class="card-title">Session Notes</div>
    <textarea class="session-notes" id="sessionNotes" placeholder="Energy, sleep, feel, any observations..."></textarea></div>
