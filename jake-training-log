  const volumes = relevant.map(s => {
    const ex = s.exercises.find(e => e.id === exId);
    return ex ? ex.sets.reduce((a, s) => a + s.reps, 0) : 0;
  });
  const rpes = relevant.map(s => {
    const ex = s.exercises.find(e => e.id === exId);
    return ex ? Math.round(ex.avgRpe * 10) / 10 : 0;
  });

  const chartDefaults = {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { ticks: { font: { family: 'Barlow Condensed', size: 11 }, color: '#7A8499' }, grid: { color: '#E8EBF0' } },
      y: { ticks: { font: { family: 'Barlow Condensed', size: 11 }, color: '#7A8499' }, grid: { color: '#E8EBF0' } }
    }
  };

  if (volumeChartInst) volumeChartInst.destroy();
  volumeChartInst = new Chart(document.getElementById('volumeChart'), {
    type: 'bar',
    data: {
      labels,
      datasets: [{ data: volumes, backgroundColor: '#0A2B6E', borderRadius: 4 }]
    },
    options: { ...chartDefaults }
  });

  if (rpeChartInst) rpeChartInst.destroy();
  rpeChartInst = new Chart(document.getElementById('rpeChart'), {
    type: 'line',
    data: {
      labels,
      datasets: [{
        data: rpes,
        borderColor: '#D94E08',
        backgroundColor: 'rgba(217,78,8,0.08)',
        pointBackgroundColor: '#D94E08',
        pointRadius: 4,
        tension: 0.3,
        fill: true
      }]
    },
    options: { ...chartDefaults, scales: { ...chartDefaults.scales, y: { ...chartDefaults.scales.y, min: 1, max: 10 } } }
  });

  // PRs
  const prList = document.getElementById('prList');
  const allEx = new Map();
  state.sessions.forEach(s => s.exercises?.forEach(e => {
    const vol = e.sets.reduce((a, s) => a + s.reps, 0);
    if (!allEx.has(e.id) || allEx.get(e.id).vol < vol) {
      allEx.set(e.id, { name: e.name, vol, date: s.date });
    }
  }));

  if (!allEx.size) {
    prList.innerHTML = `<div style="color:var(--text3);font-size:13px;">No sessions logged yet.</div>`;
  } else {
    prList.innerHTML = [...allEx.entries()].map(([id, data]) =>
      `<div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);">
        <span style="font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:15px;color:var(--text);">${data.name}</span>
        <span style="font-size:12px;font-family:'Barlow Condensed',sans-serif;letter-spacing:0.5px;color:var(--teal);">${data.vol} reps · ${formatDate(data.date)}</span>
      </div>`
    ).join('');
  }
}

// ─── EXPORT ────────────────────────────────────────────────────────────────────

function exportData() {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `jake_training_${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

// ─── PANEL SWITCHING ───────────────────────────────────────────────────────────

function switchPanel(name) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('panel-' + name).classList.add('active');
  event.target.classList.add('active');
  if (name === 'history') renderHistory();
  if (name === 'charts') { populateExerciseDropdown(); renderCharts(); }
}

// ─── INIT ──────────────────────────────────────────────────────────────────────

buildDayGrid();
buildProgram();
</script>
</body>
