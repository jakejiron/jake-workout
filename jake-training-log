  // Warmup
  if (dayData.warmup) {
    html += `<div class="card"><div class="card-title">Warm-Up — 4 min</div>`;
    dayData.warmup.forEach((item, i) => {
      html += `<div class="checklist-item" id="wu-${i}" onclick="toggleWarmup(${i})">
        <input type="checkbox" id="wucb-${i}" onclick="event.stopPropagation();toggleWarmup(${i})">
        <label for="wucb-${i}">${item}</label>
      </div>`;
    });
