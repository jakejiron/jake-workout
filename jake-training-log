// ─── UTILITIES ─────────────────────────────────────────────────────────────────

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}

function formatDate(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
}

function getCurrentTarget(exId) {
  if (state.progressTargets[exId] !== undefined) return state.progressTargets[exId];
  const prog = PROGRESSION[exId];
  if (!prog) return null;
  return 0; // index into ladder
}

function getLadderLabel(exId) {
  const prog = PROGRESSION[exId];
  if (!prog) return '';
  const idx = getCurrentTarget(exId);
  return prog.ladder[idx] || prog.ladder[prog.ladder.length - 1];
}

function getNextLadderLabel(exId) {
  const prog = PROGRESSION[exId];
  if (!prog) return null;
  const idx = getCurrentTarget(exId);
  if (idx + 1 >= prog.ladder.length) return null;
  return prog.ladder[idx + 1];
}

// ─── UI BUILDER ────────────────────────────────────────────────────────────────

function getDayActiveClass(i) {
  const type = DAYS[i].label.toLowerCase();
  if (type === 'strength') return 'active-strength';
  if (type === 'hypertrophy') return 'active-hypertrophy';
  if (type === 'recovery') return 'active-recovery';
  return 'active-rest';
}

function buildDayGrid() {
  const grid = document.getElementById('dayGrid');
  grid.innerHTML = DAYS.map((d, i) => `
    <div class="day-btn ${i === selectedDay ? getDayActiveClass(i) : ''}" onclick="selectDay(${i})">
      <div class="day-name">${d.name}</div>
      <div class="day-type">${d.label}</div>
    </div>
  `).join('');
}

function selectDay(idx) {
  selectedDay = idx;
  buildDayGrid();
  buildProgram();
}

function buildProgram() {
  const content = document.getElementById('programContent');
  const dayData = PROGRAM[selectedDay];
  const dayInfo = DAYS[selectedDay];

  if (!dayData) {
    content.innerHTML = `<div class="card"><div style="text-align:center;padding:40px 20px;color:var(--text3);">
      <div style="font-size:28px;margin-bottom:8px;">—</div>
      <div style="font-size:16px;font-weight:700;">Rest Day</div>
      <div style="font-size:13px;margin-top:6px;">No structured movement. Recover well.</div>
    </div></div>`;
    return;
  }

  const bannerClass = dayInfo.label === 'Strength' ? 'strength' : dayInfo.label === 'Hypertrophy' ? 'hypertrophy' : 'recovery';
  let html = `<div class="session-banner ${bannerClass}">
    <div>
      <div class="banner-day">${dayInfo.label}</div>
      ${dayInfo.theme ? `<div class="banner-theme">${dayInfo.theme}</div>` : ''}
    </div>
    <div style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:32px;color:rgba(255,255,255,0.08);">${dayInfo.name.toUpperCase()}</div>
  </div>`;

  if (dayData.satNote) {
    html += `<div class="note-box">⚠ Stop immediately if left hip, glute, or hamstring is provoked.</div>`;
  }

  // Recovery days
  if (dayData.recovery) {
    html += `<div class="card"><div class="card-title">Active Recovery Checklist</div>`;
    dayData.recovery.forEach((item, i) => {
      html += `<div class="checklist-item" id="check-${i}" onclick="toggleCheck(${i})">
        <input type="checkbox" id="cb-${i}" onclick="event.stopPropagation();toggleCheck(${i})">
        <label for="cb-${i}">${item}</label>
      </div>`;
    });
    html += `<div class="btn-row"><button class="btn btn-primary" onclick="saveRecovery()">Save Session</button></div></div>`;
    html += `<div class="card"><div class="card-title">Session Notes</div>
      <textarea class="session-notes" id="sessionNotes" placeholder="How did it feel?"></textarea></div>`;
