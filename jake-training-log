// ─── STATE ─────────────────────────────────────────────────────────────────────

function loadState() {
  try { return JSON.parse(localStorage.getItem('jake_tracker') || '{}'); } catch(e) { return {}; }
}
function saveState(s) { localStorage.setItem('jake_tracker', JSON.stringify(s)); }

let state = loadState();
if (!state.sessions) state.sessions = [];
if (!state.progressTargets) state.progressTargets = {};
if (!state.consecutiveCount) state.consecutiveCount = {};

let selectedDay = new Date().getDay();
if (selectedDay === 0) selectedDay = 6; else selectedDay--;
