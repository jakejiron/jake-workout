// ─── SAVE SESSION ──────────────────────────────────────────────────────────────

function saveRecovery() {
  const notes = document.getElementById('sessionNotes')?.value || '';
  const session = {
    id: Date.now(),
    date: new Date().toISOString(),
    day: selectedDay,
    dayName: DAYS[selectedDay].name,
    type: 'recovery',
    notes
  };
  state.sessions.unshift(session);
  saveState(state);
  showToast('Recovery session saved');
}

function saveSession() {
  const dayData = PROGRAM[selectedDay];
  if (!dayData || !dayData.exercises) return;

  const allExercises = [...(dayData.core || []), ...dayData.exercises];
  const exercises = [];
  let totalReps = 0;

  allExercises.forEach(ex => {
    const sets = [];
    let allTargetMet = true;
    let totalRpe = 0;
    let validSets = 0;

    for (let s = 1; s <= ex.sets; s++) {
      const repsEl = document.getElementById(`${ex.id}-reps-${s}`);
      const asstEl = document.getElementById(`${ex.id}-asst-${s}`);
      const rpeEl = document.getElementById(`${ex.id}-rpe-${s}`);
      const reps = repsEl ? parseInt(repsEl.value) || 0 : 0;
      const asst = asstEl ? parseInt(asstEl.value) || 0 : 0;
      const unassisted = Math.max(0, reps - asst);
      const rpe = rpeEl ? parseInt(rpeEl.value) || 0 : 0;
      sets.push({ reps, asst, unassisted, rpe });
      if (reps > 0) { totalRpe += rpe; validSets++; }
      if (unassisted < ex.reps) allTargetMet = false;
      totalReps += reps;
    }

    const weight = document.getElementById(`${ex.id}-weight`)?.value || '';
    const notes = document.getElementById(`${ex.id}-notes`)?.value || '';
    const avgRpe = validSets > 0 ? totalRpe / validSets : 0;

    exercises.push({ id: ex.id, name: ex.name, sets, weight, notes, avgRpe, allTargetMet });
  });

  const sessionNotes = document.getElementById('sessionNotes')?.value || '';

  const session = {
    id: Date.now(),
    date: new Date().toISOString(),
    day: selectedDay,
    dayName: DAYS[selectedDay].name,
    type: DAYS[selectedDay].label,
    exercises,
    notes: sessionNotes
  };

  // Check for PRs
  session.exercises.forEach(ex => {
    const totalVol = ex.sets.reduce((a, s) => a + s.reps, 0);
    const prevBest = state.sessions
      .filter(s => s.exercises?.some(e => e.id === ex.id))
      .map(s => s.exercises.find(e => e.id === ex.id)?.sets.reduce((a, s) => a + s.reps, 0) || 0);
    const prevMax = Math.max(0, ...prevBest);
    if (totalVol > prevMax) ex.isPR = true;
  });

  state.sessions.unshift(session);

  // Check overload
  checkOverload(session);

  saveState(state);
  showToast('Session saved!');
}

// ─── PROGRESSIVE OVERLOAD CHECK ────────────────────────────────────────────────

function checkOverload(session) {
  if (!session.exercises) return;
  pendingOverloads = [];

  session.exercises.forEach(ex => {
    const prog = PROGRESSION[ex.id];
    if (!prog) return;

    const currentIdx = getCurrentTarget(ex.id);
    if (currentIdx >= prog.ladder.length - 1) return; // already at max

    const allMet = ex.allTargetMet;
    const avgRpe = ex.avgRpe;

    if (!allMet || avgRpe > prog.rpeThresh) {
      state.consecutiveCount[ex.id] = 0;
      return;
    }

    if (!state.consecutiveCount[ex.id]) state.consecutiveCount[ex.id] = 0;
    state.consecutiveCount[ex.id]++;

    if (state.consecutiveCount[ex.id] >= prog.triggerSessions) {
      pendingOverloads.push({ exId: ex.id, exName: ex.name, currentIdx });
      state.consecutiveCount[ex.id] = 0;
    }
  });

  saveState(state);
  if (pendingOverloads.length > 0) {
    pendingOverloadIdx = 0;
    setTimeout(() => showOverloadModal(), 500);
  }
}

function showOverloadModal() {
  if (pendingOverloadIdx >= pendingOverloads.length) return;
  const item = pendingOverloads[pendingOverloadIdx];
  const prog = PROGRESSION[item.exId];
  const from = prog.ladder[item.currentIdx];
  const to = prog.ladder[item.currentIdx + 1];

  document.getElementById('modalTitle').textContent = `Progress ${item.exName}?`;
  document.getElementById('modalBody').textContent = `You've completed ${prog.triggerSessions} consecutive sessions hitting all target reps at RPE ≤${prog.rpeThresh}. Ready to advance.`;
  document.getElementById('modalProgress').textContent = `${from}  →  ${to}`;
  document.getElementById('modalConfirm').onclick = () => confirmOverload(item.exId, item.currentIdx);
  document.getElementById('overloadModal').classList.add('open');
}

function confirmOverload(exId, currentIdx) {
  state.progressTargets[exId] = currentIdx + 1;
  saveState(state);
  closeModal();
  showToast(`✓ ${exId} target updated`);
  pendingOverloadIdx++;
  if (pendingOverloadIdx < pendingOverloads.length) {
    setTimeout(() => showOverloadModal(), 400);
  }
  buildProgram();
}

function closeModal() {
  document.getElementById('overloadModal').classList.remove('open');
}

// ─── CLEAR FORM ────────────────────────────────────────────────────────────────

function clearForm() {
  const dayData = PROGRAM[selectedDay];
  if (!dayData?.exercises) return;
  dayData.exercises.forEach(ex => {
    for (let s = 1; s <= ex.sets; s++) {
      const r = document.getElementById(`${ex.id}-reps-${s}`);
      const p = document.getElementById(`${ex.id}-rpe-${s}`);
      if (r) r.value = '';
      if (p) p.value = '';
    }
    const w = document.getElementById(`${ex.id}-weight`);
    const n = document.getElementById(`${ex.id}-notes`);
    if (w) w.value = '';
    if (n) n.value = '';
  });
  const sn = document.getElementById('sessionNotes');
  if (sn) sn.value = '';
}

